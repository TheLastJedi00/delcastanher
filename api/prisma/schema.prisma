// Schema do banco Neon (PostgreSQL). A URL de conexao vive em `prisma7.config.ts`,
// que le `DATABASE_URL` do ambiente.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Sem extensao nos imports internos: o build do Nest e o Jest resolvem
  // arquivos .ts, e o especificador "./enums.js" quebraria os dois.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// Perfil do usuario na plataforma. O `id` e o proprio UID do Firebase Auth,
/// que continua sendo a fonte de verdade da autenticacao: aqui ficam apenas os
/// dados de perfil e o estado do onboarding.
model User {
  id                  String   @id
  email               String   @unique
  name                String?
  bio                 String?
  phone               String?
  linkedin            String?
  onboardingCompleted Boolean  @default(false)

  /// **Espelho de leitura** do custom claim `role` do Firebase, que continua
  /// sendo a fonte da autorizacao: `FirebaseAuthGuard` e `RolesGuard` decidem
  /// pelo token, e esta coluna nunca e consultada para autorizar. Ela existe
  /// porque filtrar, ordenar e contar por papel sobre o claim exigiria uma
  /// chamada ao Admin SDK por linha da listagem (Spec 013, decisao 3).
  ///
  /// Escrita em duas portas: `PATCH /admin/users/:id/role`, sempre depois do
  /// `setCustomUserClaims`, e a propria entrada do usuario, que reconcilia o
  /// espelho com o claim que veio no token (decisao 4).
  role                Role     @default(aluno)

  /// Ultima entrada na plataforma, carimbada em `GET /users/me` — e nao a cada
  /// requisicao autenticada, que poria um UPDATE no caminho quente. A
  /// granularidade e de sessao, nao de clique (Spec 013, decisao 5). Nulo
  /// significa "nao acessou desde que a coluna existe", e nao "inativo".
  lastSeenAt          DateTime?

  /// Preenchido enquanto a conta esta bloqueada; espelha o `disabled` do
  /// Firebase, que e quem de fato recusa o login. Bloquear nao apaga nada:
  /// exclusao de conta e o direito de eliminacao da Spec 009, outro fluxo
  /// (Spec 013, decisao 9).
  blockedAt           DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  progress     LessonProgress[]
  certificates Certificate[]
  orders       Order[]
  accesses     ModuleAccess[]

  // Sustentam o filtro por papel e o KPI de alunos ativos sem varredura.
  @@index([role])
  @@index([lastSeenAt])
  @@map("users")
}

/// Perfis de acesso da plataforma, espelhados de `auth.types.ts`. O enum vive
/// tambem aqui para que o filtro por papel da listagem administrativa seja uma
/// coluna tipada, e nao texto livre.
enum Role {
  aluno
  admin

  @@map("role")
}

/// Curso da plataforma. Hoje existe um unico curso (Spec 008, decisao 5), mas
/// modula-lo como tabela evita reescrever progresso e certificado quando o
/// catalogo crescer.
///
/// `workloadHours` e nulo de proposito: a carga horaria ainda e o placeholder
/// `[CARGA HORÁRIA]` no mock comercial (Spec 006), e inventar um numero aqui
/// colocaria dado falso dentro de um diploma. Nulo significa "a definir", e o
/// front trata visualmente como placeholder.
model Course {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  workloadHours Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  modules      Module[]
  certificates Certificate[]

  @@map("courses")
}

/// Modulo da trilha — desde a Spec 012 um **container de aulas**, e nao mais a
/// propria aula. Ele guarda apenas o que agrupa (`order`, `title`, `summary`):
/// video e materiais pertencem a `Lesson` (Spec 012, decisao 2).
///
/// O `aside` do AVA navega por modulo na vertical; a trilha enumerada
/// horizontal navega pelas aulas de um modulo.
model Module {
  id       String @id @default(cuid())
  courseId String
  order    Int
  title    String
  summary  String

  /// Preco de venda do modulo, em centavos (Spec 014, decisao 1). Modulo e a
  /// unidade de compra desde esta spec: o aluno escolhe um ou varios na loja e
  /// recebe 6 meses de acesso a cada um.
  ///
  /// **Nulo significa "a definir"**, como em `Course.workloadHours`: o modulo
  /// aparece na loja como "em breve", sem botao, e a API recusa qualquer
  /// pedido que o inclua. A migration desta spec preencheu 19900 (R$ 199,00)
  /// nos modulos que ja existiam — valor provisorio do time, trocavel pelo
  /// painel —, mas o default continua nulo para que modulo novo tenha o preco
  /// decidido, e nao herdado por descuido.
  priceCents Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons      Lesson[]
  certificates Certificate[]
  orderItems   OrderItem[]
  accesses     ModuleAccess[]

  @@unique([courseId, order])
  @@map("modules")
}

/// Aula: um video e N materiais complementares. As Specs 008 (decisao 3) e 010
/// (decisao 1) recusaram este nivel enquanto modulo e video eram 1:1 — o custo
/// era migrar progresso e certificado para acomodar um nome. Com varios videos
/// por modulo, cada um com o seu material, o produto deixou de caber em uma
/// coluna de `muxPlaybackId` (Spec 012, decisao 1).
model Lesson {
  id       String @id @default(cuid())
  moduleId String
  order    Int
  title    String
  summary  String

  /// Caminho do arquivo original no bucket. Fonte e backup do video: o objeto
  /// nunca e publico, e todo acesso sai por URL assinada de curta duracao.
  /// Objetos novos vao para `lessons/<lessonId>/...`; os enviados antes da
  /// Spec 012 continuam com o prefixo `modules/<moduleId>/` gravado aqui, e
  /// seguem validos — o caminho e dado, nao algo derivado do id (decisao 4).
  videoStoragePath  String?
  videoOriginalName String?
  videoSizeBytes    Int?
  /// Asset e playback id no Mux, a distribuicao por CDN do mesmo arquivo.
  muxAssetId        String?
  muxPlaybackId     String?
  /// Nulo enquanto a aula nao tem video. Depois do upload a ingestao do Mux
  /// e assincrona, e o aluno nao pode receber um player que so falha: o estado
  /// vira dado, atualizado por webhook (Spec 010, decisao 5).
  videoStatus       VideoStatus?
  videoError        String?
  /// Duracao em segundos, vinda do proprio Mux no `video.asset.ready`. Nao e
  /// digitada pelo admin: divergiria do arquivo no primeiro reenvio. Nula
  /// significa "ainda nao processado" (Spec 012, decisao 18).
  durationSeconds   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module    Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  materials Material[]
  progress  LessonProgress[]

  @@unique([moduleId, order])
  @@map("lessons")
}

/// Estagios da ingestao do video no Mux. `PENDING` e o arquivo ja confirmado no
/// Storage mas ainda sem asset; `PROCESSING` e o asset criado e em
/// transcodificacao; so `READY` reproduz.
enum VideoStatus {
  PENDING
  PROCESSING
  READY
  ERRORED

  @@map("video_status")
}

/// Material complementar de uma aula (PDF, planilha, documento). Guarda o
/// caminho no bucket, nunca uma URL: a URL de download e assinada no momento da
/// consulta e expira (Spec 010, decisao 15).
///
/// O dono e a aula, e nao o modulo (Spec 012, decisao 2): material pendurado no
/// modulo nao dizia a qual video pertencia.
model Material {
  id          String   @id @default(cuid())
  lessonId    String
  storagePath String   @unique
  fileName    String
  fileType    String
  sizeBytes   Int
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, order])
  @@map("materials")
}

/// Conclusao de uma **aula** por um aluno. A ausencia de linha significa aula
/// em aberto: desmarcar e apagar o registro, nao guardar um booleano falso.
///
/// Nao existe linha equivalente para modulo: "modulo concluido" e derivado de
/// "todas as aulas do modulo concluidas", calculado na leitura. Guardar as duas
/// coisas permitiria o estado impossivel — modulo concluido com aula em aberto
/// (Spec 012, decisao 5).
model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

/// Um certificado ativo ou revogado. `REVOKED` e o que torna o estado
/// "Invalido" do portal publico alcancavel (Spec 008, decisao 8).
enum CertificateStatus {
  ACTIVE
  REVOKED

  @@map("certificate_status")
}

/// Diploma emitido para um aluno. `moduleId` nulo e o diploma do curso inteiro
/// (Spec 008); preenchido, e o diploma daquele modulo (Spec 010, decisao 11) —
/// e desde a Spec 012 (decisao 13) o de modulo exige **todas as aulas** dele
/// concluidas. Nao existe diploma de aula. `code` e o identificador curto que a
/// pessoa digita no portal publico; `hash` e derivado dos dados da emissao com
/// o segredo do servidor e denuncia adulteracao no banco. Nome do aluno, titulo
/// e carga horaria nao sao copiados aqui: vem das relacoes, para que o diploma
/// nunca exiba um dado defasado.
///
/// A unicidade do diploma de curso nao cabe em `@@unique`: no Postgres um
/// indice unico com coluna nula nao restringe nada, entao ela e um indice
/// unico **parcial** (`WHERE module_id IS NULL`) criado em SQL na migration.
model Certificate {
  id        String            @id @default(cuid())
  userId    String
  courseId  String
  moduleId  String?
  code      String            @unique
  hash      String
  status    CertificateStatus @default(ACTIVE)
  issuedAt  DateTime          @default(now())
  revokedAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// `Restrict`, e nao `Cascade`: com a administracao de modulos aberta pela
  /// Spec 012, apagar um modulo em `Cascade` apagaria os diplomas emitidos
  /// dele em silencio. Modulo que ja certificou alguem nao e removivel
  /// (decisao 15).
  module Module? @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@unique([userId, moduleId])
  @@map("certificates")
}

/// Pedido de compra de modulos (Spec 014). Registra a transacao; quem abre o
/// conteudo e `ModuleAccess`, e nao esta tabela (decisao 4).
///
/// O valor cobrado e sempre calculado no servidor a partir de
/// `Module.priceCents` — o cliente envia ids de modulo, nunca preco (decisao
/// 2) — e vive aqui em centavos inteiros, como em toda a spec (decisao 3).
model Order {
  id     String      @id @default(cuid())
  userId String
  status OrderStatus @default(PENDING)

  /// Soma dos itens, em centavos, no instante da compra.
  amountCents Int
  method      PaymentMethodKind
  /// Sempre 1 no PIX; 1..6 no cartao, com juros do comprador (decisao 9).
  installments Int              @default(1)

  /// `ORD...` da Orders API do Mercado Pago: e a chave da reconsulta
  /// (`GET /v1/orders/:id`) e do webhook do topico `order` (decisoes 7 e 12).
  mpOrderId String? @unique
  /// `PAY...` da transacao dentro da order. Guardado porque e o numero que o
  /// aluno ve no extrato e o que o suporte procura no painel do Mercado Pago.
  mpPaymentId String?
  /// Par cru devolvido pelo gateway, sem traducao: quando o desfecho nao
  /// fizer sentido, quem responde e o que o Mercado Pago disse, e nao a nossa
  /// interpretacao dele. `mpStatusDetail` tambem e a origem da mensagem
  /// exibida ao comprador numa recusa.
  mpStatus       String?
  mpStatusDetail String?

  /// Instante da aprovacao. E dele que saem os 6 meses de acesso (decisao 5).
  paidAt DateTime?
  /// Vencimento do PIX, espelhando o `expiration_time` enviado na order.
  /// Passado sem pagamento, o pedido vira `EXPIRED` (decisao 10).
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  accesses ModuleAccess[]

  @@index([userId, createdAt])
  @@map("orders")
}

/// Estados do pedido nesta plataforma. Sao **nossos**: a traducao a partir do
/// status da order do Mercado Pago acontece em um ponto so (decisao 7), e
/// status desconhecido vira `PENDING` — nunca `PAID`.
enum OrderStatus {
  PENDING
  PAID
  REJECTED
  CANCELLED
  EXPIRED
  REFUNDED

  @@map("order_status")
}

/// Meios de pagamento aceitos nesta spec. Boleto, debito e carteira ficaram de
/// fora de proposito (ver "Fora de escopo" do context.md).
enum PaymentMethodKind {
  PIX
  CREDIT_CARD

  @@map("payment_method_kind")
}

/// Item do pedido, com **snapshot** de preco e titulo (decisao 6). O
/// administrador vai reajustar `Module.priceCents`, e um pedido que lesse o
/// preco vigente reescreveria o passado a cada reajuste: recibo e suporte
/// precisam do que foi cobrado, nao do que vale hoje.
model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  moduleId String

  priceCents    Int
  titleSnapshot String

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// `Restrict`, e nao `Cascade`: modulo ja vendido nao e removivel, pelo
  /// mesmo motivo que modulo ja certificado nao e (Spec 012, decisao 15).
  /// Apagar em cascata sumiria com o historico de uma compra paga.
  module Module @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@unique([orderId, moduleId])
  @@map("order_items")
}

/// Direito de acesso de um aluno a um modulo (Spec 014, decisao 4).
///
/// **E esta linha, e nao o pagamento, que abre o conteudo.** Ler "existe
/// pagamento aprovado com este modulo" a cada requisicao amarraria o portao ao
/// historico financeiro e deixaria cortesia e migracao sem lugar. Aqui, acesso
/// ativo e uma pergunta so — `expiresAt > agora` —, igual para quem comprou,
/// quem ganhou e quem ja estava na plataforma antes do paywall.
///
/// A unicidade e `(userId, moduleId)`: recomprar estende o periodo em vez de
/// criar uma segunda linha, para que nenhuma leitura de acesso precise de um
/// `max()` sobre historico (decisao 5).
model ModuleAccess {
  id       String @id @default(cuid())
  userId   String
  moduleId String

  /// Instante da ultima concessao — compra, recompra ou cortesia.
  grantedAt DateTime @default(now())
  /// Fim do acesso. Vencido, o conteudo tranca, mas progresso e certificado
  /// continuam intactos: nada e apagado (decisoes 5 e 18).
  expiresAt DateTime
  source    AccessSource
  /// Preenchido quando a origem e uma compra. E por ele que o estorno revoga
  /// exatamente o que aquele pedido liberou (decisao 22).
  orderId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, moduleId])
  // Sustenta o portao do conteudo: uma consulta por requisicao, com o mapa de
  // acessos ativos do aluno, e nunca uma consulta por modulo.
  @@index([userId, expiresAt])
  @@index([orderId])
  @@map("module_access")
}

/// De onde veio o acesso. `PURCHASE` e a compra; `COURTESY` e a concessao
/// administrativa para suporte e teste; `LEGACY` e o backfill que liberou as
/// contas que ja existiam quando o paywall entrou (decisao 20).
enum AccessSource {
  PURCHASE
  COURTESY
  LEGACY

  @@map("access_source")
}
