# Chave Web do projeto Firebase (Console > Project settings > Web API Key).
# Usada para autenticar via Firebase Auth REST API (signInWithPassword / sendOobCode).
FIREBASE_WEB_API_KEY=

# Credencial do service account (Console > Project settings > Service accounts).
# JSON completo em uma unica linha, entre aspas simples.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# URL base do frontend. Usada como continueUrl (actionUrl) dos emails do Firebase:
# apos definir a senha o usuario volta para <FRONTEND_URL>/login.
FRONTEND_URL=http://localhost:4200

# Origens liberadas no CORS da API: lista separada por virgula, sem barra final.
# Fora de producao e opcional e assume http://localhost:4200.
# Em producao e OBRIGATORIA: sem ela a API nao sobe, para o front publicado nao
# ficar bloqueado pelo navegador sem aviso. No deploy, use o dominio do front:
#   CORS_ORIGINS=https://delcastanher.vercel.app
CORS_ORIGINS=http://localhost:4200

PORT=3000

# Segredo usado para assinar (HMAC) o hash dos certificados emitidos.
# Fora de producao e opcional e cai em um segredo de desenvolvimento.
# Em producao e OBRIGATORIA: sem ela a API nao emite nem verifica certificado.
# Trocar o valor invalida os certificados ja emitidos.
CERTIFICATE_HASH_SECRET=
