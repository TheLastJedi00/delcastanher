# Chave Web do projeto Firebase (Console > Project settings > Web API Key).
# Usada para autenticar via Firebase Auth REST API (signInWithPassword / sendOobCode).
FIREBASE_WEB_API_KEY=

# Credencial do service account (Console > Project settings > Service accounts).
# JSON completo em uma unica linha, entre aspas simples.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# URL base do frontend. Usada como continueUrl (actionUrl) dos emails do Firebase:
# apos definir a senha o usuario volta para <FRONTEND_URL>/login.
FRONTEND_URL=http://localhost:4200

# Origens liberadas no CORS da API: lista separada por virgula, sem barra final.
# Fora de producao e opcional e assume http://localhost:4200.
# Em producao e OBRIGATORIA: sem ela a API nao sobe, para o front publicado nao
# ficar bloqueado pelo navegador sem aviso. No deploy, use o dominio do front:
#   CORS_ORIGINS=https://delcastanher.vercel.app
CORS_ORIGINS=http://localhost:4200

PORT=3000

# Segredo usado para assinar (HMAC) o hash dos certificados emitidos.
# Fora de producao e opcional e cai em um segredo de desenvolvimento.
# Em producao e OBRIGATORIA: sem ela a API nao emite nem verifica certificado.
# Trocar o valor invalida os certificados ja emitidos.
CERTIFICATE_HASH_SECRET=

# --- Storage e CDN (Spec 010) ---

# Bucket do Firebase Storage, PELO NOME, sem o prefixo gs:// e sem barra final.
# O console do Firebase mostra "gs://<bucket>"; o Admin SDK nao aceita o prefixo.
# Guarda o arquivo original de cada video e os materiais complementares. Nenhum
# objeto e publico: todo acesso sai por URL assinada de curta duracao.
# Depois de definir o bucket, rode `npm run storage:cors`: sem CORS o navegador
# nao consegue enviar o arquivo direto para ele.
FIREBASE_STORAGE_BUCKET=delcastanher-b9142.firebasestorage.app

# Access token da API do Mux (Dashboard > Settings > Access Tokens), com
# permissao de Mux Video. A integracao Mux do marketplace da Vercel injeta os
# mesmos valores como MUX_VIDEO_MUX_TOKEN_ID / MUX_VIDEO_MUX_TOKEN_SECRET, e a
# API aceita os dois nomes — o da spec tem precedencia.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Chave de assinatura do playback (Dashboard > Settings > Signing Keys). Os
# assets tem policy `signed`: sem isto o playbackId nao reproduz nada e
# GET /modules/:moduleId/playback-token nao tem como assinar o JWT.
# A privada e entregue em base64 pelo Mux; cole exatamente como veio.
# A integracao da Vercel injeta este par como MUX_VIDEO_KEY_ID /
# MUX_VIDEO_SECRET_KEY — sem o segundo "MUX_" que as demais variaveis tem. A
# API aceita os dois nomes, entao nao e preciso renomear a mao.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# Segredo do webhook (Dashboard > Settings > Webhooks). POST /webhooks/mux e
# rota publica por necessidade — e este segredo que separa um evento do Mux de
# um POST qualquer da internet.
MUX_WEBHOOK_SECRET=

# Origens liberadas no CORS do BUCKET, lista separada por virgula.
#
# Diferente de CORS_ORIGINS, que e por deploy: o bucket e um so, compartilhado
# por todos os ambientes, entao esta lista precisa ser a UNIAO de tudo que sobe
# arquivo — producao, previews que voce va testar e o front local.
#
# Opcional: sem ela o script cai em CORS_ORIGINS + http://localhost:4200.
# Aplique com `npm run storage:cors`, que ACRESCENTA em vez de substituir.
STORAGE_CORS_ORIGINS=https://delcastanher.vercel.app,http://localhost:4200

# --- Pagamento: Mercado Pago (Spec 014) ---
#
# Checkout Transparente processado pela ORDERS API (POST /v1/orders), e nao
# pela API de Pagamentos (/v1/payments): e o caminho recomendado para
# integracoes novas, e /v1/payments tende a virar legado (decisao 7).
#
# As credenciais saem de Suas integracoes > Delcastanher > Credenciais.
# Sandbox e producao usam O MESMO codigo: o que muda e este par de chaves
# (decisao 24).

# Credencial de servidor. NUNCA vai para o front nem para o bundle.
MP_ACCESS_TOKEN=

# Chave publica, usada pelo MercadoPago.js v2 para tokenizar o cartao.
# Ela e publica por natureza, mas mesmo assim NAO vira variavel de build do
# front: sai por GET /store/payment-config (decisao 16). Assim alternar
# sandbox e producao e um deploy so, e nao dois coordenados.
MP_PUBLIC_KEY=

# Segredo da assinatura do webhook (Suas integracoes > Webhooks > Configurar
# notificacao > revelar chave). POST /webhooks/mercadopago e rota publica por
# necessidade — e este segredo que separa uma notificacao legitima de um POST
# qualquer da internet (decisao 12).
MP_WEBHOOK_SECRET=

# `false` apenas quando as credenciais acima forem de PRODUCAO. Com `true` o
# front exibe o aviso de ambiente de teste: uma loja que cobra de mentira
# precisa dizer isso na tela.
MP_SANDBOX=true

# O que aparece na fatura do cartao do comprador. Curto e reconhecivel: uma
# cobranca que o titular nao reconhece vira contestacao.
MP_STATEMENT_DESCRIPTOR=DELCASTANHER

# ATENCAO ao webhook: o Mercado Pago exige URL PUBLICA em HTTPS, entao
# `localhost` nunca recebe notificacao. Em desenvolvimento quem fecha o pedido
# e a reconsulta de GET /orders/:id, que aplica o mesmo tratamento do webhook
# (decisao 14). O topico a assinar e `order` — e nao `payment`.
