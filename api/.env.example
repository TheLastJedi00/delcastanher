# Chave Web do projeto Firebase (Console > Project settings > Web API Key).
# Usada para autenticar via Firebase Auth REST API (signInWithPassword / sendOobCode).
FIREBASE_WEB_API_KEY=

# Credencial do service account (Console > Project settings > Service accounts).
# JSON completo em uma unica linha, entre aspas simples.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# URL base do frontend. Usada como continueUrl (actionUrl) dos emails do Firebase:
# apos definir a senha o usuario volta para <FRONTEND_URL>/login.
# O dominio precisa estar em Authentication > Settings > Authorized domains do
# Firebase, senao o e-mail nao sai. Em producao: https://www.delcastanher.srv.br
FRONTEND_URL=http://localhost:4200

# Origens liberadas no CORS da API: lista separada por virgula, sem barra final.
# Fora de producao e opcional e assume http://localhost:4200.
# Em producao e OBRIGATORIA: sem ela a API nao sobe, para o front publicado nao
# ficar bloqueado pelo navegador sem aviso. No deploy, use o dominio do front:
#   CORS_ORIGINS=https://www.delcastanher.srv.br
CORS_ORIGINS=http://localhost:4200

PORT=3000

# Duracao, em dias, do cookie HttpOnly do refresh token (Spec 017, decisao 15).
# O refresh token do Firebase nao expira sozinho: quem encerra a sessao de quem
# some e este prazo, renovado a cada refresh. Quem abre a plataforma com
# frequencia nao precisa entrar de novo. Opcional, default 30; valor que nao
# seja inteiro maior que zero derruba a subida em vez de virar outro prazo.
AUTH_REFRESH_COOKIE_MAX_AGE_DAYS=30

# Segredo usado para assinar (HMAC) o hash dos certificados emitidos.
# Fora de producao e opcional e cai em um segredo de desenvolvimento.
# Em producao e OBRIGATORIA: sem ela a API nao emite nem verifica certificado.
# Trocar o valor invalida os certificados ja emitidos.
CERTIFICATE_HASH_SECRET=

# --- Storage e CDN (Spec 010) ---

# Bucket do Firebase Storage, PELO NOME, sem o prefixo gs:// e sem barra final.
# O console do Firebase mostra "gs://<bucket>"; o Admin SDK nao aceita o prefixo.
# Guarda o arquivo original de cada video e os materiais complementares. Nenhum
# objeto e publico: todo acesso sai por URL assinada de curta duracao.
# Depois de definir o bucket, rode `npm run storage:cors`: sem CORS o navegador
# nao consegue enviar o arquivo direto para ele.
FIREBASE_STORAGE_BUCKET=delcastanher-b9142.firebasestorage.app

# Access token da API do Mux (Dashboard > Settings > Access Tokens), com
# permissao de Mux Video. A integracao Mux do marketplace da Vercel injeta os
# mesmos valores como MUX_VIDEO_MUX_TOKEN_ID / MUX_VIDEO_MUX_TOKEN_SECRET, e a
# API aceita os dois nomes — o da spec tem precedencia.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Chave de assinatura do playback (Dashboard > Settings > Signing Keys). Os
# assets tem policy `signed`: sem isto o playbackId nao reproduz nada e
# GET /modules/:moduleId/playback-token nao tem como assinar o JWT.
# A privada e entregue em base64 pelo Mux; cole exatamente como veio.
# A integracao da Vercel injeta este par como MUX_VIDEO_KEY_ID /
# MUX_VIDEO_SECRET_KEY — sem o segundo "MUX_" que as demais variaveis tem. A
# API aceita os dois nomes, entao nao e preciso renomear a mao.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# Segredo do webhook (Dashboard > Settings > Webhooks). POST /webhooks/mux e
# rota publica por necessidade — e este segredo que separa um evento do Mux de
# um POST qualquer da internet.
MUX_WEBHOOK_SECRET=

# Origens liberadas no CORS do BUCKET, lista separada por virgula.
#
# Diferente de CORS_ORIGINS, que e por deploy: o bucket e um so, compartilhado
# por todos os ambientes, entao esta lista precisa ser a UNIAO de tudo que sobe
# arquivo — producao, previews que voce va testar e o front local.
#
# Opcional: sem ela o script cai em CORS_ORIGINS + http://localhost:4200.
# Aplique com `npm run storage:cors`, que ACRESCENTA em vez de substituir; para
# podar uma origem aposentada (ex.: o antigo vercel.app), use `-- --replace`.
STORAGE_CORS_ORIGINS=https://www.delcastanher.srv.br,http://localhost:4200

# --- Pagamento: Mercado Pago (Spec 014) ---
#
# Checkout Transparente processado pela ORDERS API (POST /v1/orders), e nao
# pela API de Pagamentos (/v1/payments): e o caminho recomendado para
# integracoes novas, e /v1/payments tende a virar legado (decisao 7).
#
# As credenciais saem de Suas integracoes > Delcastanher > Credenciais.
# Sandbox e producao usam O MESMO codigo: o que muda e este par de chaves
# (decisao 24).

# Credencial de servidor. NUNCA vai para o front nem para o bundle.
# ATENCAO: a Orders API RECUSA as chaves `TEST-` (401 invalid_credentials).
# O sandbox dela e diferente do da API de Pagamentos: use as credenciais de
# PRODUCAO de um USUARIO DE TESTE. Crie o usuario de teste `seller`, entre no
# painel como ele, crie uma aplicacao nessa conta e use as chaves dela aqui.
# O pagamento e feito por um usuario de teste `buyer`, com dinheiro de teste.
#
# Desde a Spec 020 as vendas NAO nascem mais nesta conta: a order e criada com
# o token OAuth da conta recebedora, conectada pelo painel. Esta credencial
# fica so para consultar os pedidos anteriores a Spec 020 (decisao 6).
MP_ACCESS_TOKEN=

# Chave publica, usada pelo MercadoPago.js v2 para tokenizar o cartao.
# Ela e publica por natureza, mas mesmo assim NAO vira variavel de build do
# front: sai por GET /store/payment-config (decisao 16). Assim alternar
# sandbox e producao e um deploy so, e nao dois coordenados.
MP_PUBLIC_KEY=

# Segredo da assinatura do webhook (Suas integracoes > Webhooks > Configurar
# notificacao > revelar chave). POST /webhooks/mercadopago e rota publica por
# necessidade — e este segredo que separa uma notificacao legitima de um POST
# qualquer da internet (decisao 12).
MP_WEBHOOK_SECRET=

# `false` apenas quando as credenciais acima forem de PRODUCAO. Com `true` o
# front exibe o aviso de ambiente de teste: uma loja que cobra de mentira
# precisa dizer isso na tela.
MP_SANDBOX=true

# O que aparece na fatura do cartao do comprador. Curto e reconhecivel: uma
# cobranca que o titular nao reconhece vira contestacao.
MP_STATEMENT_DESCRIPTOR=DELCASTANHER

# ATENCAO ao webhook: o Mercado Pago exige URL PUBLICA em HTTPS, entao
# `localhost` nunca recebe notificacao. Em desenvolvimento quem fecha o pedido
# e a reconsulta de GET /orders/:id, que aplica o mesmo tratamento do webhook
# (decisao 14). O topico a assinar e `order` — e nao `payment`.

# --- Conta recebedora por OAuth (Spec 020) ----------------------------------
#
# As vendas caem na conta do Mercado Pago conectada em /admin > Financeiro >
# Conta recebedora. Sem conta conectada NESTE ambiente, a loja fica fechada.
# O ambiente e o da branch: preview (MP_SANDBOX=true) conecta com token de
# teste, producao com token real — e cada um tem a sua conexao, porque os dois
# dividem o banco.

# App id da aplicacao Delcastanher (Suas integracoes > Detalhes da aplicacao).
MP_CLIENT_ID=4932690255162951

# SEGREDO. Client Secret da aplicacao: troca e renova o token do vendedor.
MP_CLIENT_SECRET=

# URL de retorno do OAuth. Precisa ser IDENTICA a cadastrada em "URLs de
# redirecionamento" da aplicacao, e e da API, nao do front: e aqui que o
# `code` e trocado com o client secret e o verifier do PKCE (decisao 5).
MP_OAUTH_REDIRECT_URI=https://api.delcastanher.srv.br/mercadopago/oauth/callback

# SEGREDO. Chave AES-256-GCM dos tokens do vendedor no banco: 32 bytes em
# base64. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar a chave invalida as conexoes gravadas: basta reconectar (decisao 4).
MP_TOKEN_ENCRYPTION_KEY=

# SEGREDO. O Vercel Cron manda este valor em `Authorization: Bearer` ao chamar
# GET /internal/mercadopago/refresh, a renovacao diaria do token (decisao 8),
# e GET /internal/invoices/reconcile, a reconciliacao das notas (Spec 023).
CRON_SECRET=


# --- Nota fiscal: NF-e de livro digital pela Notaas (Spec 023, Parte A) ---
#
# Sem NOTAAS_API_KEY a emissao fica DESLIGADA: nenhuma nota e criada e a venda
# segue igual (desenvolvimento, por exemplo). Com ela, cada venda aprovada
# gera uma NF-e, cancelada no estorno dentro de 24 h.
#
# Preview e producao dividem o banco (decisao A6). Por isso:
#   - Production: a chave do projeto de PRODUCAO da Notaas e NFE_ENV=producao.
#   - Preview e Development: a chave do projeto de HOMOLOGACAO, sem NFE_ENV.
# A nota grava o ambiente em que nasceu, e o tpAmb devolvido pela Notaas
# precisa bater com NFE_ENV: se nao bater, a nota vai para ERROR e o painel
# alerta ("chave de API do ambiente errado").

# SEGREDO. Chave da API do projeto da Notaas deste ambiente (header x-api-key).
NOTAAS_API_KEY=

# SEGREDO. Secret do endpoint de webhook cadastrado no projeto da Notaas
# (POST /webhooks/endpoints), apontando para
# https://api.delcastanher.srv.br/webhooks/notaas com os eventos nfe.issued,
# nfe.error e nfe.cancelled. Confere o X-Notaas-Signature (decisao A5).
NOTAAS_WEBHOOK_SECRET=

# `producao` SO em Production. Qualquer outro valor, ou ausente, e homologacao:
# uma variavel esquecida nunca emite nota real.
NFE_ENV=homologacao

# Dados fiscais do contador (Task 1.1). NENHUM codigo fiscal fica no codigo:
# faltando um deles, a nota vai para ERROR com o nome da variavel.
# Os valores abaixo sao EXEMPLOS, a confirmar com o contador.
NFE_NATUREZA_OPERACAO=Venda de livro digital
# NCM do livro digital.
NFE_NCM=
# CFOP da venda dentro da UF e para outra UF a consumidor final nao contribuinte.
NFE_CFOP_INTERNO=
NFE_CFOP_INTERESTADUAL=
# Exatamente UM dos dois: CSOSN no Simples (ex.: 300 = imune), CST no regime
# normal (ex.: 41). A Notaas suprime o DIFAL nos itens imunes.
NFE_CSOSN=
NFE_CST=
# CST de PIS e COFINS (ex.: 07 no Simples para operacao isenta).
NFE_CST_PIS=
NFE_CST_COFINS=
# 2 = nao presencial, internet. 0 = venda no proprio site, sem marketplace.
NFE_PRESENCA_COMPRADOR=2
NFE_INDICADOR_INTERMEDIADOR=0
# Informacoes complementares da nota, citando a imunidade do livro.
NFE_INF_CPL=
# UF do emitente: separa o CFOP interno do interestadual.
NFE_EMITENTE_UF=
# Grupo IBS/CBS (reforma tributaria). So entra com os DOIS preenchidos.
NFE_IBSCBS_CST=
NFE_IBSCBS_CCLASSTRIB=

# Prazo de cancelamento da NF-e, em horas (decisao A7). Opcional, default 24.
NFE_CANCEL_WINDOW_HOURS=24

# Vencimento do certificado A1 (AAAA-MM-DD), se a Notaas nao avisar. O cron
# registra em log e o painel mostra um aviso 30 dias antes (decisao A10).
NFE_CERT_EXPIRES_AT=

# --- E-mail: Resend (Spec 023, Parte B) ---

# SEGREDO. Chave da API do Resend. Usada no e-mail da nota e nas campanhas.
RESEND_API_KEY=

# Remetente, no subdominio verificado no Resend (SPF, DKIM e DMARC no DNS).
# Opcional: o padrao e "Delcastanher <contato@mail.delcastanher.srv.br>".
EMAIL_FROM=Delcastanher <contato@mail.delcastanher.srv.br>

# SEGREDO. HMAC do link de descadastro das campanhas (decisao B5). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Trocar o valor invalida os links dos e-mails ja enviados.
EMAIL_UNSUBSCRIBE_SECRET=

# Endereco publico desta API, sem barra final. E para ele que aponta o
# List-Unsubscribe de um clique do Gmail (POST /email/unsubscribe).
# Em producao: https://api.delcastanher.srv.br
API_PUBLIC_URL=http://localhost:3000
